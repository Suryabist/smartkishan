<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".new_product.AddNewProductActivity">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:theme="@style/NewAppTheme"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/AppTheme.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">



                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:adjustViewBounds="true"
                        android:scaleType="centerCrop"
                        android:id="@+id/imageID"
                        android:layout_centerInParent="true"
                        android:layout_width="match_parent"
                        android:src="@drawable/product_detail_bg_pic"
                        android:background="#e4e4e4"
                        android:layout_height="200dp"
                        />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_camera_alt_black_24dp"
                        android:layout_height="wrap_content" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_height="wrap_content">


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/productNameID"
                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/custom_inputtext"
                        android:gravity="center"
                        android:hint="प्रोडक्टको नाम"
                        android:padding="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/productNameEditTextID"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/custom_inputtext"
                            android:singleLine="true"
                            android:padding="8dp"
                            android:textColor="#000" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/selectCategoryID"
                        android:layout_below="@+id/productNameID"
                        android:layout_width="match_parent"
                        android:padding="32dp"
                        android:textSize="16dp"
                        android:text="क्याटेगोरी सिलेक्ट गर्नुहोस"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/custom_inputtext"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/productPriceID"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/selectCategoryID"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/custom_inputtext"
                        android:gravity="center"
                        android:hint="प्रोडक्टको मूल्य नेरुमा"
                        android:padding="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/productPriceEdittextID"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/custom_inputtext"
                            android:singleLine="true"
                            android:inputType="number"
                            android:padding="16dp"
                            android:textColor="#000" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/productDescriptionID"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/productPriceID"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/custom_inputtext"
                        android:gravity="center"
                        android:hint="प्रोडक्टको विबरण"
                        android:padding="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/productDescriptionEdittextID"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/custom_inputtext"
                            android:singleLine="true"
                            android:padding="16dp"
                            android:textColor="#000" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/productDeliveryLocationID"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/productDescriptionID"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/custom_inputtext"
                        android:gravity="center"
                        android:hint="प्रोडक्ट पाउने स्थान"
                        android:padding="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/productDeliveryLocationEdittextID"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/custom_inputtext"
                            android:singleLine="true"
                            android:padding="16dp"
                            android:textColor="#000" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <Button
                        android:id="@+id/uploadButtonID"
                        android:layout_below="@id/productDeliveryLocationID"
                        android:background="@drawable/upload_button_background"
                        android:layout_marginBottom="16dp"
                        android:layout_marginTop="16dp"
                        android:text="अपलोड गर्नुहोस"
                        android:textSize="18sp"
                        android:padding="20dp"
                        android:textColor="#fff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </RelativeLayout>

            </LinearLayout>


        </ScrollView>

        <ProgressBar
            android:id="@+id/progressBarID"
            android:layout_width="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone"
            android:layout_height="wrap_content" />

    </RelativeLayout>

</LinearLayout>