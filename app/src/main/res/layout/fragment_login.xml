<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#fff"
    android:orientation="vertical"
    tools:context=".login_and_signup.LoginFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_marginTop="24dp"
                android:layout_height="wrap_content">



                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="wrap_content"
                    android:id="@+id/appIconId"
                    android:layout_centerInParent="true"
                    android:src="@drawable/smart_krishi_default_image"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/signUpTextviewId"
                    android:layout_width="wrap_content"
                    android:text="साइन अप गर्नुहोस्"
                    android:textSize="14dp"
                    android:layout_marginLeft="16dp"
                    android:layout_gravity="center"
                    android:layout_alignParentLeft="true"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/colorPrimary"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/skipTextviewId"
                    android:layout_width="wrap_content"
                    android:text="Skip"
                    android:textColor="@color/colorPrimary"
                    android:textSize="16sp"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="16dp"
                    android:drawableRight="@drawable/ic_keyboard_arrow_right_black_24dp"
                    android:layout_height="wrap_content" />



            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:textSize="24dp"
                android:text="Welcome to Smart Kishan"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:text="जारी राख्न साइन इन गर्नुहोस्"
                android:layout_gravity="center"
                android:textSize="16dp"
                android:layout_height="wrap_content" />



            <TextView
                android:layout_width="wrap_content"
                android:text="इ-मेल"
                android:layout_marginLeft="16dp"
                android:textSize="14sp"
                android:layout_marginTop="100dp"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/emailEditTextID"
                android:layout_width="match_parent"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:inputType="textCapWords|textEmailAddress"
                android:backgroundTint="@color/colorPrimary"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:text="पासवर्ड"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="16dp"
                android:textSize="14sp"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/passwordEditTextID"
                android:inputType="textPassword"
                android:layout_width="match_parent"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:backgroundTint="@color/colorPrimary"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/forgotPasswordTextviewID"
                android:layout_width="wrap_content"
                android:text="पासवर्ड भुल्नु भयो?"
                android:layout_gravity="right"
                android:textSize="14sp"
                android:layout_marginRight="16dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/signInButtonId"
                android:layout_width="match_parent"
                android:text="साइन इन"
                android:textColor="#fff"
                android:layout_margin="16dp"
                android:padding="16dp"
                android:background="@drawable/sign_in_button_background"
                android:layout_height="wrap_content" />

            <com.facebook.login.widget.LoginButton
                android:id="@+id/fb_login_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:textSize="18dp" />


            <TextView
                android:id="@+id/emailVerificationSendId"
                android:layout_width="wrap_content"
                android:text="Send verification email"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:textColor="@color/colorPrimary"
                android:layout_height="wrap_content" />
        </LinearLayout>


    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBarID"
        android:layout_width="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        android:layout_height="wrap_content" />


</RelativeLayout>