<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F1F1"
    tools:context="com.pathibharatechnology.smartkishan.login_and_signup.SignUpFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ffffff"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!--<de.hdodenhof.circleimageview.CircleImageView
                        android:layout_width="140dp"
                        android:background="#000"
                        android:layout_height="140dp"
                        android:layout_centerInParent="true" />-->

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/imageUploadCircleImageViewID"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_user" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_camera_alt_black_24dp" />

                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"
                    android:text="प्रोफाईल फोटो छान्नुहोस्"
                    android:textColor="#000" />

            </LinearLayout>

            <EditText
                android:id="@+id/fullNameEditTextID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/custom_edit_text"
                android:drawableLeft="@drawable/ic_username"
                android:hint="आफ्नो पूरा नाम लेख्नुहोस्"
                android:inputType="textCapWords"
                android:padding="16dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/emailEditTextID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/custom_edit_text"
                android:drawableLeft="@drawable/ic_email"
                android:hint="ई-मेल"
                android:inputType="textEmailAddress"
                android:maxLength="50"
                android:padding="16dp"
                android:singleLine="true" />


            <EditText
                android:id="@+id/userNameEditTextID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/custom_edit_text"
                android:drawableLeft="@drawable/ic_username"
                android:hint="प्रयोगकर्ता नाम"
                android:inputType="textCapWords"
                android:padding="16dp"
                android:singleLine="true" />


            <EditText
                android:id="@+id/mobileEditTextID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/custom_edit_text"
                android:drawableLeft="@drawable/ic_phone"
                android:hint="मोबाइल नम्बर"
                android:inputType="phone"
                android:maxLength="10"
                android:padding="16dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/passwordEditTextID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/custom_edit_text"
                android:drawableLeft="@drawable/ic_password"
                android:hint="पासवर्ड"
                android:inputType="textPassword"
                android:maxLength="50"
                android:padding="16dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/confirmPasswordEditTextID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/custom_edit_text"
                android:drawableLeft="@drawable/ic_password"
                android:hint="पासवर्ड पुन: प्रविष्टि गर्नुहोस्"
                android:inputType="textPassword"
                android:maxLength="50"
                android:padding="16dp"
                android:singleLine="true" />


            <Button
                android:id="@+id/signUpButtonID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/sign_in_button_background"
                android:padding="16dp"
                android:text="साइन अप"
                android:textColor="#fff"
                android:textSize="16dp" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="30dp">

                <TextView
                    android:id="@+id/account_hintID"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="पहिले नै खाता छ?"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/loginTextViewID"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_toRightOf="@+id/account_hintID"
                    android:text="साइन इन गर्नुहोस्"
                    android:textColor="#3BB93B"
                    android:textSize="16sp" />

            </RelativeLayout>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBarID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
