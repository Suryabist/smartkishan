<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".forum_and_discussion.DiscussionDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/addCommentId"
        android:paddingTop="8dp"
        android:layout_alignParentBottom="true"
        android:paddingBottom="8dp"
        android:elevation="4dp"
        android:layout_height="wrap_content">

        <EditText
            android:layout_weight="0.8"
            android:layout_width="0dp"
            android:background="@drawable/custom_inputtext"
            android:maxLines="3"
            android:padding="8dp"
            android:hint="Leave a comment"
            android:layout_gravity="center"
            android:id="@+id/commentTextId"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_height="wrap_content" />

        <Button
            android:layout_width="0dp"
            android:layout_weight="0.2"
            android:text="Send"
            android:id="@+id/sendCommentId"
            android:background="@drawable/custom_botton_design"
            android:layout_gravity="bottom"
            android:layout_marginRight="8dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_above="@id/addCommentId"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:context=".product_by_category.ProductByCategoryActivity"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:padding="8dp"
                        android:layout_height="wrap_content">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/imageOfPostUploaderID"
                            android:layout_width="40dp"
                            android:layout_height="40dp" />

                        <TextView
                            android:id="@+id/postUploaderNameID"
                            android:layout_width="wrap_content"
                            android:textSize="16sp"
                            android:layout_marginLeft="8dp"
                            android:textStyle="bold"
                            android:layout_toRightOf="@id/imageOfPostUploaderID"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/postUploadTimeID"
                            android:layout_width="wrap_content"
                            android:textSize="14sp"
                            android:layout_marginLeft="8dp"
                            android:layout_marginTop="2dp"
                            android:layout_below="@id/postUploaderNameID"
                            android:layout_toRightOf="@id/imageOfPostUploaderID"
                            android:layout_height="wrap_content" />

                        <ImageView
                            android:id="@+id/optionsId"
                            android:layout_width="20dp"
                            android:src="@drawable/ic_option"
                            android:layout_alignParentRight="true"
                            android:layout_height="20dp" />

                    </RelativeLayout>

                    <TextView
                        android:id="@+id/contentID"
                        android:layout_width="match_parent"
                        android:padding="8dp"
                        android:ellipsize="end"
                        android:textSize="14sp"
                        android:maxLines="3"
                        android:layout_marginBottom="8dp"
                        android:layout_height="wrap_content" />

                    <ImageView
                        android:id="@+id/postImageID"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:padding="16dp"
                        android:layout_height="wrap_content">


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="0.5"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:padding="2dp"
                            android:layout_height="wrap_content" >

                            <ToggleButton
                                android:id="@+id/likeID"
                                android:gravity="center"
                                android:background="@drawable/toggle_selector"
                                android:textOff=""
                                android:textOn=""
                                android:layout_width="36dp"
                                android:layout_height="36dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:id="@+id/likesCountId"
                                android:text="0 Likes"
                                android:layout_marginLeft="16dp"
                                android:textSize="16sp"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/commentID"
                            android:gravity="center"
                            android:padding="8dp"
                            android:drawableLeft="@drawable/ic_comment"
                            android:layout_width="0dp"
                            android:layout_toRightOf="@+id/likeID"
                            android:text="Comment"
                            android:layout_weight="0.5"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:background="#f2f2f2"
                        android:id="@+id/recyclerViewID"
                        android:layout_marginBottom="4dp"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </RelativeLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>